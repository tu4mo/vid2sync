{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["eslint", "import", "react", "typescript", "unicorn", "oxc"],
  "rules": {
    "eslint/capitalized-comments": [
      "error",
      "always",
      { "ignoreConsecutiveComments": true }
    ],
    "eslint/curly": ["error", "all"],
    "eslint/func-style": ["error", "declaration"],
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    "typescript/consistent-type-definitions": ["error", "type"],
    "react/only-export-components": ["error", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      "rules": {
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": ["src/panels/*/*"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./[^.]|panels/",
                "message": "Panels can't import from other panels. Move shared code to src/lib or src/components."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/panels/*/*/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./\\.\\./[^.]|panels/",
                "message": "Panels can't import from other panels. Move shared code to src/lib or src/components."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/panels/*/*/*/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./\\.\\./\\.\\./[^.]|panels/",
                "message": "Panels can't import from other panels. Move shared code to src/lib or src/components."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "Shared components can't import from outside src/components. Pass app-specific data and behavior in as props."
              }
            ]
          }
        ]
      }
    }
  ]
}
